// Schema Prisma - Application HACCP multi-etablissements
// SQLite en local (bascule facile vers PostgreSQL en changeant "provider" et l'url)
// Note: SQLite ne supporte pas les enums natifs -> champs String valides en code (voir constants.js)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
  output        = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  sites          Site[]
  users          User[]
  suppliers      Supplier[]
  products       Product[]
  auditTemplates AuditTemplate[]
  documents      Document[]
}

model Site {
  id                  String   @id @default(cuid())
  name                String
  establishmentNumber String?
  address             String?
  organizationId      String
  createdAt           DateTime @default(now())

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  receptions      Reception[]
  equipments      Equipment[]
  serviceChecks   ServiceTemperatureCheck[]
  cleaningZones   CleaningZone[]
  nonConformities NonConformity[]
  audits          Audit[]
}

// role: SUPER_ADMIN | ORG_ADMIN | SITE_MANAGER | EMPLOYEE
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           String   @default("EMPLOYEE")
  organizationId String
  siteId         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?           @relation(fields: [siteId], references: [id])
  trainings    StaffTraining[]
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  contact        String?
  phone          String?
  email          String?
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
  receptions   Reception[]
}

// storageType: FROID_POSITIF | FROID_NEGATIF | CHAUD | AMBIANT
model Product {
  id                   String   @id @default(cuid())
  name                 String
  category             String?
  storageType          String   @default("FROID_POSITIF")
  defaultShelfLifeDays Int?
  organizationId       String
  supplierId           String?
  createdAt            DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  receptions   Reception[]
}

model Reception {
  id                     String    @id @default(cuid())
  siteId                 String
  supplierId             String
  productId              String
  lotNumber              String
  dlc                    DateTime?
  quantity               Float?
  unit                   String?
  temperatureAtReception Float?
  conform                Boolean   @default(true)
  nonConformityNote      String?
  receivedAt             DateTime  @default(now())
  receivedBy             String?

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
}

// type: FRIGO | CONGELATEUR | CHAMBRE_FROIDE | VITRINE_CHAUDE | AMBIANT
model Equipment {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  type      String   @default("FRIGO")
  targetMin Float
  targetMax Float
  createdAt DateTime @default(now())

  site     Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  readings TemperatureReading[]
}

model TemperatureReading {
  id          String   @id @default(cuid())
  equipmentId String
  value       Float
  recordedAt  DateTime @default(now())
  recordedBy  String?
  alert       Boolean  @default(false)
  notes       String?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

// mealService: PETIT_DEJEUNER | DEJEUNER | DINER | AUTRE
// stage: DEBUT | MILIEU | FIN (moment du service ou a lieu le controle)
model ServiceTemperatureCheck {
  id          String   @id @default(cuid())
  siteId      String
  dishName    String
  value       Float
  mealService String   @default("DEJEUNER")
  stage       String?
  minRequired Float?
  maxRequired Float?
  conform     Boolean  @default(true)
  checkedAt   DateTime @default(now())
  checkedBy   String?
  notes       String?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model CleaningZone {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  createdAt DateTime @default(now())

  site  Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tasks CleaningTask[]
}

// frequency: QUOTIDIEN | HEBDOMADAIRE | MENSUEL | TRIMESTRIEL
model CleaningTask {
  id        String   @id @default(cuid())
  zoneId    String
  name      String
  frequency String   @default("QUOTIDIEN")
  product   String?
  createdAt DateTime @default(now())

  zone CleaningZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  logs CleaningLog[]
}

model CleaningLog {
  id      String   @id @default(cuid())
  taskId  String
  doneAt  DateTime @default(now())
  doneBy  String?
  conform Boolean  @default(true)
  notes   String?

  task CleaningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// severity: MINEURE | MAJEURE | CRITIQUE ; status: OUVERTE | EN_COURS | RESOLUE
model NonConformity {
  id          String    @id @default(cuid())
  siteId      String
  title       String
  description String?
  category    String?
  severity    String    @default("MINEURE")
  status      String    @default("OUVERTE")
  declaredBy  String?
  declaredAt  DateTime  @default(now())
  resolvedAt  DateTime?

  site    Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  actions CorrectiveAction[]
}

// status: A_FAIRE | EN_COURS | TERMINEE
model CorrectiveAction {
  id              String    @id @default(cuid())
  nonConformityId String
  description     String
  assignedTo      String?
  dueDate         DateTime?
  status          String    @default("A_FAIRE")
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  nonConformity NonConformity @relation(fields: [nonConformityId], references: [id], onDelete: Cascade)
}

model AuditTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  questions      String   // JSON stringifie: [{ id, label, category }]
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audits       Audit[]
}

model Audit {
  id          String   @id @default(cuid())
  siteId      String
  templateId  String
  performedBy String?
  performedAt DateTime @default(now())
  answers     String   // JSON stringifie: [{ questionId, ok, comment }]
  score       Float    // pourcentage de conformite

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  template AuditTemplate @relation(fields: [templateId], references: [id])
}

model Document {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  category       String?
  content        String?  // texte ou notes de la procedure
  version        String   @default("1.0")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model StaffTraining {
  id         String    @id @default(cuid())
  userId     String
  title      String
  obtainedAt DateTime?
  expiresAt  DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
